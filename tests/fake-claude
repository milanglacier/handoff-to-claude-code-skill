#!/usr/bin/env python3
"""Offline stand-in for the Claude CLI used by test_handoff.py."""

import json
import os
import sys
import time


DEFAULT_TEXT = """# Answer

Some **markdown** text.
- a
- b"""
DEFAULT_USAGE = {
    "claude-opus-5": {
        "inputTokens": 10,
        "outputTokens": 5,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 3800,
        "costUSD": 0.0123,
        "canonicalModel": "claude-opus-5",
    }
}


def write_json(path, value):
    if path:
        with open(path, "w", encoding="utf-8") as handle:
            json.dump(value, handle)


def main():
    args = sys.argv[1:]
    if args == ["--version"]:
        print("9.9.9 (Fake Claude)")
        return 0

    write_json(os.environ.get("FAKE_CLAUDE_ARGV_LOG"), args)
    write_json(
        os.environ.get("FAKE_CLAUDE_ENV_LOG"),
        {
            "ANTHROPIC_API_KEY": os.environ.get("ANTHROPIC_API_KEY"),
            "ANTHROPIC_AUTH_TOKEN": os.environ.get("ANTHROPIC_AUTH_TOKEN"),
            "PWD": os.environ.get("PWD"),
        },
    )

    if os.environ.get("FAKE_CLAUDE_SLEEP"):
        time.sleep(float(os.environ["FAKE_CLAUDE_SLEEP"]))
    if os.environ.get("FAKE_CLAUDE_STDERR"):
        print(os.environ["FAKE_CLAUDE_STDERR"], file=sys.stderr)
    if os.environ.get("FAKE_CLAUDE_SIGNAL"):
        os.kill(os.getpid(), int(os.environ["FAKE_CLAUDE_SIGNAL"]))

    text = os.environ.get("FAKE_CLAUDE_TEXT", DEFAULT_TEXT)
    if "json" in args:
        raw_usage = os.environ.get("FAKE_CLAUDE_MODEL_USAGE")
        usage = json.loads(raw_usage) if raw_usage is not None else DEFAULT_USAGE
        print(
            json.dumps(
                {
                    "type": "result",
                    "subtype": "success",
                    "is_error": os.environ.get("FAKE_CLAUDE_IS_ERROR") == "1",
                    "result": text,
                    "session_id": os.environ.get(
                        "FAKE_CLAUDE_SESSION",
                        "11111111-2222-3333-4444-555555555555",
                    ),
                    "total_cost_usd": 0.0123,
                    "modelUsage": usage,
                }
            )
        )
    else:
        print(text)
    return int(os.environ.get("FAKE_CLAUDE_EXIT", "0"))


if __name__ == "__main__":
    sys.exit(main())
